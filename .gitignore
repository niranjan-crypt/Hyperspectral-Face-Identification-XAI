# ==============================================================================
# Git Ignore Configuration for Hyperspectral-Face-Identification-XAI
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
.venv*/
venv/
env/
ENV/
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# macOS and OS metadata
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db

# IDEs and configuration
.vscode/
.idea/
*.swp
*.swo
*~

# Multi-Gigabyte Raw Hyperspectral Data Cubes & Archives
# (dataset1.spe is 8.24 GiB; dataset1_Ref.spe is 16.48 GiB - exceeds GitHub 100MB limit)
*.spe
*.figspec*
*.7z
*.tar.gz
*.zip
*30bands_multispectral*
*.npy
*.tiff

# Intermediate processing cache
outputs/cache/
track2_hyperspectral_puma/outputs/cache/
*.npz

# Heavy model weights and checkpoints
saved_models/*.h5
saved_models/*.keras
track1_rgb_baseline/saved_models/*.keras
track1_rgb_baseline/saved_models/*.h5

# Logs
logs/
*.log
runs/
wandb/

# Explicit Whitelist: Preserve analytical checkpoints, tables, figures, and PDF reports
!outputs/checkpoints/*.json
!track2_hyperspectral_puma/outputs/checkpoints/*.json
!outputs/figures/*.png
!track2_hyperspectral_puma/outputs/figures/*.png
!outputs/tables/*.csv
!outputs/tables/*.json
!track2_hyperspectral_puma/outputs/tables/*.csv
!track2_hyperspectral_puma/outputs/tables/*.json
!outputs/*.pdf
!track2_hyperspectral_puma/outputs/*.pdf
!comparison_results.csv
!dataset1.hdr
!dataset1.xlsx
!dataset1.jpg
